<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="center"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
        <com.google.android.material.imageview.ShapeableImageView
                android:maxWidth="120dp"
                android:layout_width="100dp"
                android:minWidth="70dp"
                android:layout_height="70dp"
                android:id="@+id/payment_method_image_view"
                android:scaleType="centerCrop"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="25dp"
                tools:src="@tools:sample/avatars"
                app:srcCompat="@color/green_avatar_bg"
                app:shapeAppearance="@style/ShapeAppearance.CineBook.MediumComponent"/>
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/payment_method_id_text_view"
                    android:fontFamily="@font/dm_sans_extrabold"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="13sp"
                    app:autoSizeMaxTextSize="24sp"
                    android:textColor="@color/text_primary"
                    android:textAlignment="textStart"
                    tools:text="**** 4242"/>
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/payment_method_description_text_view"
                    android:fontFamily="@font/dm_sans_regular"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="textStart"
                    tools:text="Expires 08/28"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
                android:id="@+id/status_button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:text="default"
                app:backgroundTint="@color/icon_green_10"
                android:textColor="@color/green_accent"
                android:padding="0dp"
                android:fontFamily="@font/dm_sans_light"
                android:visibility="invisible"
                android:textSize="11sp"/>
        <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/chevron_forward_24px"
                android:backgroundTint="@color/transparent"
                android:id="@+id/edit_button"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>