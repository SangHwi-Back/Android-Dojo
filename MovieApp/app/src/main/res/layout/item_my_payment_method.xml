<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="center"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:clipChildren="false"
            android:orientation="horizontal">

        <FrameLayout
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="12dp"
                android:clipChildren="false">

            <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="120dp"
                    android:layout_height="90dp"
                    android:id="@+id/payment_method_image_view"
                    android:scaleType="centerCrop"
                    android:padding="10dp"
                    tools:src="@tools:sample/avatars"
                    app:srcCompat="@color/green_avatar_bg"
                    app:tint="@color/design_default_color_background"
                    app:shapeAppearance="@style/ShapeAppearance.CineBook.MediumComponent"/>

            <TextView android:id="@+id/status_button"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="top|start"
                      android:paddingHorizontal="12dp"
                      android:paddingVertical="2dp"
                      android:text="default"
                      android:background="@drawable/bg_date_chip_selected"
                      android:textColor="@color/badge_text"
                      android:fontFamily="@font/dm_sans_bold"
                      android:visibility="invisible"
                      tools:visibility="visible"
                      android:textSize="11sp"/>
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/payment_method_id_text_view"
                    android:fontFamily="@font/dm_sans_extrabold"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="13sp"
                    app:autoSizeMaxTextSize="24sp"
                    android:textColor="@color/text_primary"
                    android:textAlignment="textStart"
                    tools:text="**** 4242"/>
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/payment_method_description_text_view"
                    android:fontFamily="@font/dm_sans_regular"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="textStart"
                    tools:text="Expires 08/28"/>
        </LinearLayout>
        <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/chevron_forward_24px"
                android:backgroundTint="@color/transparent"
                android:id="@+id/edit_button"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>