<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/movie_name_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:fontFamily="@font/dm_sans_bold"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg"
                android:layout_marginTop="16dp"
                tools:text="Midnight Sonata"/>
        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/theater_name_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:fontFamily="@font/dm_sans_bold"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg"
                android:layout_marginTop="24dp"
                tools:text="IMAX Cineplex Downtown"/>
        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/showtime_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/dm_sans_medium"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm"
                tools:text="Fri, Mar 15 · 7:30 PM · Hall 3"/>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/image_view_qr_code"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_margin="16dp"
                        android:src="@drawable/rounded_dashed_background"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.CineBook.SmallComponent"/>
                <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        android:textAlignment="center"
                        android:fontFamily="@font/dm_sans_medium"
                        android:text="@string/qr_description"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.15"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:textSize="@dimen/text_base"
                android:fontFamily="@font/dm_sans_medium"
                android:text="@string/seat_header"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="@color/text_secondary"/>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seats_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp" />

        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/booking_ref_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:textSize="@dimen/text_sm"
                android:fontFamily="@font/dm_sans_medium"
                android:textColor="@color/text_secondary"
                tools:text="Booking Ref: CB-88213" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/add_to_wallet_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/surface_card"
                android:textColor="@color/white"
                android:textSize="@dimen/text_base"
                android:fontFamily="@font/dm_sans_bold"
                app:cornerRadius="12dp"
                android:text="@string/action_add_to_wallet"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_booking_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="#FF4444"
                android:text="@string/cancel_block_button"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>