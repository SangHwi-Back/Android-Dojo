<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/movie_view_pager"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <TextView
            android:id="@+id/book_choose_info_title_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center_vertical"
            tools:text="@string/label_select_date"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_lg"
            tools:drawableStartCompat="@drawable/calendar_today_outlined_24px"
            app:drawableTint="@color/green_accent"
            app:layout_constraintTop_toBottomOf="@id/movie_view_pager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/movie_choose_info_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/book_choose_info_title_text_view"
            app:layout_constraintBottom_toTopOf="@id/button_linear_layout" />

    <LinearLayout
            android:id="@+id/button_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/go_prev_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:backgroundTint="@color/material_dynamic_secondary60"
                android:textColor="@color/white"
                android:layout_marginEnd="12dp"
                android:text="@string/action_prev"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/go_next_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/action_next"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>