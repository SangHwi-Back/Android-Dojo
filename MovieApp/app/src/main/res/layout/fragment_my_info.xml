<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".myinfo.MyInfoFragment">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_marginTop="4dp"
                android:theme="@style/Widget.CineBook.CardView">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/user_profile_image_view"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="16dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_background"
                        app:backgroundTint="@color/surface_card"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/person_outlined_24px"/>

                <LinearLayout
                        android:id="@+id/user_profile_status_linear_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/user_profile_name_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CineBook.VenueName"
                            android:text="@string/label_guest_user"/>

                    <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/user_profile_status_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CineBook.Body.Medium"
                            android:text="@string/sign_in_description"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/user_sign_in_button"
                        android:theme="@style/Widget.CineBook.Button.SignIn"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/action_sign_in"
                        android:layout_marginEnd="4dp"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_info_history_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="16dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_upcoming_bookings"
                android:fontFamily="@font/dm_sans_semibold"
                android:textSize="@dimen/text_lg"
                android:textColor="@color/text_primary"
                android:layout_margin="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_info_upcoming_movie_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_marginBottom="24dp"/>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_info_user_status_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>